<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         Mollie App — Configuration Page
         Accessible via Mollie ▶ Configuration
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Form view for the Mollie configuration form -->
    <record id="view_mollie_config_settings_form" model="ir.ui.view">
        <field name="name">mollie.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Mollie Configuration" class="oe_form_configuration">
                <header>
                    <button string="Save" type="object" name="execute" class="btn-primary"/>
                    <button string="Discard" type="object" name="cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="app_settings_block">

                        <!-- ── Recurring Payments Section ── -->
                        <h2>Recurring Payments</h2>
                        <div class="row mt16">
                            <div class="col-12 col-lg-6">
                                <div class="o_setting_box">
                                    <div class="o_setting_left_pane"/>
                                    <div class="o_setting_right_pane">
                                        <label for="mollie_recurring_company_id" class="o_form_label"/>
                                        <div class="text-muted">
                                            Restrict all Mollie recurring charges, cron jobs, and
                                            payment status fetches to this company only. Subscriptions
                                            from other companies will not be touched.
                                        </div>
                                        <div class="content-group mt8">
                                            <div class="row">
                                                <label for="mollie_recurring_company_id" string="Active Company" class="col-lg-4 o_light_label"/>
                                                <field name="mollie_recurring_company_id" class="col-lg-8"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open the Mollie configuration page -->
    <record id="action_mollie_config_settings" model="ir.actions.act_window">
        <field name="name">Mollie Configuration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mollie_config_settings_form"/>
        <field name="target">inline</field>
        <field name="context">{'module': 'mollie_recurring_payments'}</field>
    </record>

</odoo>
