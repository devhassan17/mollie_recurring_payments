<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ensure giftcard payment method exists and is linked to Mollie -->
        <record id="payment_method_mollie_gift_card" model="payment.method">
            <field name="name">Gift Card</field>
            <field name="code">giftcard</field>
            <field name="sequence">90</field>
            <field name="image" type="base64" file="payment_mollie/static/description/icon.png"/> <!-- Fallback to Mollie icon -->
            <field name="support_tokenization">False</field>
            <field name="support_express_checkout">False</field>
            <field name="support_refund">partial</field>
        </record>

    </data>
</odoo>
